{
  "name": "git-tm",
  "version": "1.1.1",
  "description": "Explore any Git repository in your browser: commit graph, diffs, blame, insights and time travel between any two commits. Zero dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./git": {
      "types": "./src/types/git.d.ts",
      "default": "./src/git.js"
    },
    "./server": {
      "types": "./src/types/server.d.ts",
      "default": "./src/server.js"
    },
    "./graph": {
      "types": "./src/types/graph.d.ts",
      "default": "./src/public/js/graph.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "git-tm": "src/cli.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandhu-44/Git-Time-Machine.git"
  },
  "keywords": [
    "git",
    "git-tm",
    "git-time-machine",
    "time-travel",
    "git-history",
    "git-log",
    "git-graph",
    "commit-graph",
    "git-gui",
    "git-ui",
    "history-viewer",
    "diff",
    "blame",
    "compare",
    "cli",
    "developer-tools",
    "visualization",
    "api"
  ],
  "author": "nandhu-44",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nandhu-44/Git-Time-Machine/issues"
  },
  "homepage": "https://git-time-machine.js.org"
}
